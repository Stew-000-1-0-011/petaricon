// The design canvas: the live preview inside a ComponentContainer, a selection overlay,
// and one TouchArea that decides between tap, move, resize and pan.

import { LineEdit } from "std-widgets.slint";

// One tappable guide number: a padding band or a spacing gap, in design coordinates.
export struct GuideBand {
    x: length,
    y: length,
    w: length,
    h: length,
    value: int,
    property: string,
    is-gap: bool,
}

// A dashed horizontal / vertical line: 6px segments with 4px gaps.
component Dashes inherits Rectangle {
    in property <length> len;
    in property <bool> vertical;
    in property <color> stroke: #4fc3f7;
    for i in Math.ceil(root.len / 10px): Rectangle {
        x: root.vertical ? 0px : i * 10px;
        y: root.vertical ? i * 10px : 0px;
        width: root.vertical ? 2px : max(0px, min(6px, root.len - i * 10px));
        height: root.vertical ? max(0px, min(6px, root.len - i * 10px)) : 2px;
        background: root.stroke;
    }
}

export component Canvas inherits Rectangle {
    in property <component-factory> factory;
    in property <bool> has-selection;
    // The selection rectangle in design coordinates (unscaled).
    in property <length> sel-x;
    in property <length> sel-y;
    in property <length> sel-w;
    in property <length> sel-h;
    in property <length> design-w: 360px;
    in property <length> design-h: 640px;
    in property <float> zoom: 1.0;
    in property <bool> has-guides;
    // Layout outline in design coordinates and its direction.
    in property <length> g-x;
    in property <length> g-y;
    in property <length> g-w;
    in property <length> g-h;
    in property <bool> g-vertical;
    in property <[GuideBand]> bands;
    in property <bool> has-align;
    in property <length> a-x;
    in property <length> a-y;
    in property <length> a-w;
    in property <length> a-h;
    // Bumped by the glue whenever the guided layout changes; closes the edit popup.
    in property <int> guides-rev;
    changed guides-rev => { root.editing-prop = ""; }
    callback guide-edited(string /* property */, string /* value */);
    property <string> editing-prop;
    property <string> editing-value;
    property <length> editing-x;
    property <length> editing-y;
    in-out property <length> pan-x: 8px;
    in-out property <length> pan-y: 8px;

    // Coordinates are relative to the design origin and still scaled by `zoom`.
    callback tapped(length, length);
    callback drag-finished(length, length);
    callback resize-finished(int /* Corner: 0 TL, 1 TR, 2 BL, 3 BR */, length, length);
    // Multiplier for the current zoom (two-finger gesture).
    callback zoom-by(float);

    // 0 none, 1 move selection, 2 resize selection, 3 pan
    property <int> mode;
    property <int> corner;
    property <bool> dragged;
    property <length> drag-dx;
    property <length> drag-dy;
    property <length> start-pan-x;
    property <length> start-pan-y;
    property <float> last-scale: 1.0;

    // Selection rectangle in canvas coordinates, including an in-progress drag.
    property <length> base-x: root.pan-x + root.sel-x * root.zoom;
    property <length> base-y: root.pan-y + root.sel-y * root.zoom;
    property <length> base-w: root.sel-w * root.zoom;
    property <length> base-h: root.sel-h * root.zoom;
    property <bool> moving: root.mode == 1 && root.dragged;
    property <bool> resizing: root.mode == 2 && root.dragged;
    property <bool> left-moves: root.corner == 0 || root.corner == 2;
    property <bool> top-moves: root.corner == 0 || root.corner == 1;
    property <length> ov-x: root.moving ? root.base-x + root.drag-dx
        : root.resizing && root.left-moves ? root.base-x + root.drag-dx : root.base-x;
    property <length> ov-y: root.moving ? root.base-y + root.drag-dy
        : root.resizing && root.top-moves ? root.base-y + root.drag-dy : root.base-y;
    property <length> ov-w: root.resizing
        ? max(4px, root.base-w + (root.left-moves ? -root.drag-dx : root.drag-dx)) : root.base-w;
    property <length> ov-h: root.resizing
        ? max(4px, root.base-h + (root.top-moves ? -root.drag-dy : root.drag-dy)) : root.base-h;

    // Corner handles win only near a corner; the radius shrinks for small selections so the
    // interior stays draggable. The nearest corner wins.
    function corner-at(px: length, py: length) -> int {
        if !root.has-selection { return -1; }
        // Pick the nearest corner of the selection.
        let r = min(24px, min(root.base-w, root.base-h) / 3);
        let left-d = abs(px - root.base-x);
        let right-d = abs(px - (root.base-x + root.base-w));
        let top-d = abs(py - root.base-y);
        let bottom-d = abs(py - (root.base-y + root.base-h));
        let dx = min(left-d, right-d);
        let dy = min(top-d, bottom-d);
        if dx > r || dy > r { return -1; }
        return (left-d <= right-d ? 0 : 1) + (top-d <= bottom-d ? 0 : 2);
    }

    // True when a 44px box centred on (cx, cy) would reach a corner-handle zone.
    function label-blocked(cx: length, cy: length) -> bool {
        if !root.has-selection { return false; }
        let r = min(24px, min(root.base-w, root.base-h) / 3) + 22px;
        let dx = min(abs(cx - root.base-x), abs(cx - (root.base-x + root.base-w)));
        let dy = min(abs(cy - root.base-y), abs(cy - (root.base-y + root.base-h)));
        return dx <= r && dy <= r;
    }

    function inside-selection(px: length, py: length) -> bool {
        root.has-selection && px >= root.base-x && px <= root.base-x + root.base-w
            && py >= root.base-y && py <= root.base-y + root.base-h
    }

    background: #2b2f34;
    clip: true;

    Rectangle {
        x: root.pan-x;
        y: root.pan-y;
        width: root.design-w;
        height: root.design-h;
        transform-scale: root.zoom;
        transform-origin: { x: 0px, y: 0px };
        background: white;

        ComponentContainer {
            width: parent.width;
            height: parent.height;
            component-factory: root.factory;
        }
    }

    if root.has-selection: Rectangle {
        x: root.ov-x;
        y: root.ov-y;
        width: root.ov-w;
        height: root.ov-h;
        border-width: 2px;
        border-color: #e020e0;
        background: #e020e020;

        for c in [0, 1, 2, 3]: Rectangle {
            x: (c == 1 || c == 3) ? parent.width - self.width / 2 : -self.width / 2;
            y: (c == 2 || c == 3) ? parent.height - self.height / 2 : -self.height / 2;
            width: 14px;
            height: 14px;
            background: white;
            border-width: 2px;
            border-color: #e020e0;
        }
    }

    gesture := ScaleRotateGestureHandler {
        width: parent.width;
        height: parent.height;
        started => { root.last-scale = 1.0; }
        updated => {
            root.zoom-by(self.scale / root.last-scale);
            root.last-scale = self.scale;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.editing-prop = "";
                    root.dragged = false;
                    root.drag-dx = 0;
                    root.drag-dy = 0;
                    root.start-pan-x = root.pan-x;
                    root.start-pan-y = root.pan-y;
                    root.corner = root.corner-at(self.mouse-x, self.mouse-y);
                    if root.corner >= 0 {
                        root.mode = 2;
                    } else if root.inside-selection(self.mouse-x, self.mouse-y) {
                        root.mode = 1;
                    } else {
                        root.mode = 3;
                    }
                } else if e.kind == PointerEventKind.up {
                    if root.mode != 0 {
                        if !root.dragged {
                            root.tapped(self.mouse-x - root.pan-x, self.mouse-y - root.pan-y);
                        } else if root.mode == 1 {
                            root.drag-finished(root.drag-dx, root.drag-dy);
                        } else if root.mode == 2 {
                            root.resize-finished(root.corner, root.drag-dx, root.drag-dy);
                        }
                    }
                    root.mode = 0;
                    root.dragged = false;
                    root.drag-dx = 0;
                    root.drag-dy = 0;
                } else if e.kind == PointerEventKind.cancel {
                    root.mode = 0;
                    root.dragged = false;
                    root.drag-dx = 0;
                    root.drag-dy = 0;
                    root.pan-x = root.start-pan-x;
                    root.pan-y = root.start-pan-y;
                }
            }
            moved => {
                if root.mode == 0 { return; }
                root.drag-dx = self.mouse-x - self.pressed-x;
                root.drag-dy = self.mouse-y - self.pressed-y;
                if abs(root.drag-dx) > 6px || abs(root.drag-dy) > 6px {
                    root.dragged = true;
                }
                if root.mode == 3 && root.dragged {
                    root.pan-x = root.start-pan-x + root.drag-dx;
                    root.pan-y = root.start-pan-y + root.drag-dy;
                }
            }
        }
    }

    if root.has-guides: Rectangle {
        x: root.pan-x + root.g-x * root.zoom;
        y: root.pan-y + root.g-y * root.zoom;
        width: root.g-w * root.zoom;
        height: root.g-h * root.zoom;
        Dashes { x: 0px; y: 0px; len: parent.width; }
        Dashes { x: 0px; y: parent.height - 2px; len: parent.width; }
        Dashes { x: 0px; y: 0px; len: parent.height; vertical: true; }
        Dashes { x: parent.width - 2px; y: 0px; len: parent.height; vertical: true; }
        Text {
            x: 4px;
            y: 4px;
            text: root.g-vertical ? "↓" : "→";
            color: #4fc3f7;
            font-size: 16px;
        }
    }

    for b in root.bands: Rectangle {
        x: root.pan-x + b.x * root.zoom;
        y: root.pan-y + b.y * root.zoom;
        width: b.w * root.zoom;
        height: b.h * root.zoom;
        background: b.is-gap ? #ffb74d50 : #4fc3f740;
    }

    // Only a 44x44 box around each number takes input (never the band itself), and not where
    // it would cover a corner handle of the selection.
    for b in root.bands: Rectangle {
        property <length> cx: root.pan-x + (b.x + b.w / 2) * root.zoom;
        property <length> cy: root.pan-y + (b.y + b.h / 2) * root.zoom;
        x: self.cx - 22px;
        y: self.cy - 22px;
        width: 44px;
        height: 44px;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: b.value;
            color: white;
            font-size: 11px;
        }
        TouchArea {
            enabled: !root.label-blocked(parent.cx, parent.cy);
            clicked => {
                root.editing-prop = b.property;
                root.editing-value = "\{b.value}";
                root.editing-x = max(4px, min(root.width - 124px, parent.cx - 60px));
                root.editing-y = max(4px, min(root.height - 48px, parent.cy - 20px));
            }
        }
    }

    if root.has-guides && root.has-align: Rectangle {
        x: root.pan-x + root.a-x * root.zoom;
        y: root.pan-y + root.a-y * root.zoom;
        Dashes {
            x: 0px;
            y: 0px;
            len: (root.a-w > 0px ? root.a-w : root.a-h) * root.zoom;
            vertical: root.a-w == 0px;
            stroke: #f06292;
        }
    }

    if root.editing-prop != "": Rectangle {
        x: root.editing-x;
        y: root.editing-y;
        width: 120px;
        height: 44px;
        background: #2a2e33;
        border-radius: 6px;
        border-width: 1px;
        border-color: #4fc3f7;
        TouchArea { }
        edit := LineEdit {
            x: 4px;
            y: 2px;
            width: parent.width - 8px;
            height: parent.height - 4px;
            input-type: InputType.number;
            text <=> root.editing-value;
            init => { self.focus(); }
            accepted(t) => {
                root.guide-edited(root.editing-prop, t);
                root.editing-prop = "";
            }
        }
    }
}
