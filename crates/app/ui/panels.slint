import { LineEdit, ListView, TextEdit } from "std-widgets.slint";

export struct TreeRowItem {
    label: string,
    depth: int,
    is-layout: bool,
    selected: bool,
}

export struct PropItem {
    name: string,
    value: string,
}

export component ToolButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 44px;
    background: !root.enabled ? transparent : ta.pressed ? #4a5058 : #383d44;
    border-radius: 4px;
    Text {
        text: root.text;
        color: root.enabled ? white : #777c83;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The bottom panel: tab strip and (for now empty) content areas.
export component BottomPanel inherits Rectangle {
    // Height the panel is dragged to; only used in portrait.
    in-out property <length> panel-h;
    in property <length> max-h;
    in property <bool> handle-visible: true;
    in-out property <int> tab: 0;
    in property <[TreeRowItem]> tree-rows;
    in property <[string]> palette;
    in property <[PropItem]> props;
    in property <string> source-title;
    in-out property <string> source-text;
    // How far the on-screen keyboard reaches into the bottom of this panel.
    in property <length> kb-overlap;
    in property <bool> touch-input;
    callback prop-edited(string, string);
    callback prop-accepted(string, string);
    // A value field got focus: name, its text, and the window y of the field's bottom edge.
    callback value-focused(string, string, length);
    callback value-blurred();
    callback source-apply(string);
    callback source-edited();
    callback tree-selected(int);
    // 0 up, 1 down, 2 out, 3 in, 4 delete, 5 new container
    callback tree-action(int);
    callback palette-picked(string);
    property <[string]> tab-names: ["Tree", "Parts", "Props", "Source"];
    property <length> start-y;
    property <length> start-h;

    background: #24282c;

    VerticalLayout {
        if root.handle-visible: Rectangle {
            height: 18px;
            background: #30353b;
            Rectangle {
                width: 40px;
                height: 4px;
                border-radius: 2px;
                background: #6b727a;
            }
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.start-y = self.absolute-position.y + self.mouse-y;
                        root.start-h = root.panel-h;
                    }
                }
                moved => {
                    root.panel-h = clamp(
                        root.start-h - (self.absolute-position.y + self.mouse-y - root.start-y),
                        80px, root.max-h);
                }
            }
        }
        HorizontalLayout {
            height: 44px;
            for name[i] in root.tab-names: Rectangle {
                background: root.tab == i ? #3a4a5c : transparent;
                Text {
                    text: name;
                    color: white;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.tab = i; } }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            if root.tab == 0: VerticalLayout {
                padding: 4px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 3px;
                    height: 44px;
                    ToolButton { text: "Up"; clicked => { root.tree-action(0); } }
                    ToolButton { text: "Down"; clicked => { root.tree-action(1); } }
                    ToolButton { text: "Out"; clicked => { root.tree-action(2); } }
                    ToolButton { text: "In"; clicked => { root.tree-action(3); } }
                    ToolButton { text: "Del"; clicked => { root.tree-action(4); } }
                    ToolButton { text: "Box+"; clicked => { root.tree-action(5); } }
                }
                ListView {
                    for row[i] in root.tree-rows: Rectangle {
                        height: 44px;
                        background: row.selected ? #3a4a5c : transparent;
                        Text {
                            x: 8px + row.depth * 16px;
                            width: parent.width - self.x - 4px;
                            text: row.label;
                            color: row.is-layout ? #8fc7ff : white;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea { clicked => { root.tree-selected(i); } }
                    }
                }
            }
            if root.tab == 1: ListView {
                for name in root.palette: Rectangle {
                    height: 44px;
                    Text {
                        x: 12px;
                        text: "+  " + name;
                        color: white;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.palette-picked(name); } }
                }
            }
            if root.tab == 2: ListView {
                for p in root.props: row := Rectangle {
                    height: 44px;
                    Text {
                        x: 8px;
                        width: 38%;
                        text: p.name;
                        color: p.value == "" ? #8a9199 : white;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // On touch devices the field is not a text input: tapping it opens the input bar,
                    // whose field gets the first (and only) text focus.
                    if root.touch-input: Rectangle {
                        x: parent.width * 0.4;
                        y: 2px;
                        width: parent.width - self.x - 6px;
                        height: 40px;
                        background: #2a2e33;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #4a5058;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: p.value;
                            color: white;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            clicked => { root.value-focused(p.name, p.value, row.absolute-position.y + row.height); }
                        }
                    }
                    if !root.touch-input: LineEdit {
                        x: parent.width * 0.4;
                        y: 2px;
                        width: parent.width - self.x - 6px;
                        height: 40px;
                        text: p.value;
                        changed has-focus => {
                            if self.has-focus {
                                root.value-focused(p.name, self.text, row.absolute-position.y + row.height);
                            } else {
                                root.value-blurred();
                            }
                        }
                        edited(t) => { root.prop-edited(p.name, t); }
                        accepted(t) => { root.prop-accepted(p.name, t); }
                    }
                }
            }
            if root.tab == 3: VerticalLayout {
                padding: 4px;
                // Only this area shrinks above the keyboard.
                padding-bottom: 4px + root.kb-overlap;
                spacing: 4px;
                // With the keyboard up, Apply moves next to the title so it stays above it.
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: root.source-title;
                        color: #9aa3ad;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.kb-overlap > 0px: ToolButton {
                        text: "Apply";
                        min-width: 72px;
                        height: 44px;
                        clicked => { root.source-apply(root.source-text); }
                    }
                }
                src := TextEdit {
                    vertical-stretch: 1;
                    min-height: 60px;
                    font-size: 13px;
                    text <=> root.source-text;
                    edited(_) => { root.source-edited(); }
                }
                if root.kb-overlap <= 0px: ToolButton {
                    text: "Apply";
                    height: 44px;
                    clicked => { root.source-apply(src.text); }
                }
            }
        }
    }
}

export component MenuList inherits Rectangle {
    in property <string> title;
    in property <[string]> items;
    in property <string> current;
    callback picked(string);
    min-height: 90px;
    VerticalLayout {
        spacing: 2px;
        Text { text: root.title; color: #9aa3ad; font-size: 12px; }
        ListView {
            for item in root.items: Rectangle {
                height: 44px;
                background: item == root.current ? #3a4a5c : transparent;
                Text {
                    x: 8px;
                    text: item;
                    color: white;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.picked(item); } }
            }
        }
    }
}

export component NewProject inherits HorizontalLayout {
    callback create(string);
    callback rename();
    spacing: 6px;
    height: 44px;
    name := LineEdit { placeholder-text: "new project"; }
    ToolButton {
        text: "Create";
        min-width: 64px;
        clicked => {
            if name.text != "" {
                root.create(name.text);
                name.text = "";
            }
        }
    }
    ToolButton { text: "Rename"; min-width: 64px; clicked => { root.rename(); } }
}

// Buttons acting on the files of the selected project and on the open file.
export component FileActions inherits HorizontalLayout {
    callback new-file();
    callback rename();
    callback save-as();
    spacing: 6px;
    height: 44px;
    ToolButton { text: "New file"; horizontal-stretch: 1; clicked => { root.new-file(); } }
    ToolButton { text: "Rename"; horizontal-stretch: 1; clicked => { root.rename(); } }
    ToolButton { text: "Save as..."; horizontal-stretch: 1; clicked => { root.save-as(); } }
}

// Menu section "Settings": the tolerance of Tidy with - / value / + (the glue steps it by 4px).
export component SettingsSection inherits VerticalLayout {
    in property <int> tolerance;
    callback step(int);
    spacing: 2px;
    Text { text: "Settings"; color: #9aa3ad; font-size: 12px; }
    HorizontalLayout {
        height: 44px;
        spacing: 6px;
        Text {
            text: "Tidy tolerance";
            color: white;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        ToolButton { text: "-"; min-width: 44px; clicked => { root.step(-1); } }
        Text {
            text: "\{root.tolerance}px";
            color: white;
            font-size: 14px;
            min-width: 44px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ToolButton { text: "+"; min-width: 44px; clicked => { root.step(1); } }
    }
}

// Input bar docked above the on-screen keyboard: label, text field, OK. Every element is 44px high.
export component KbBar inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <InputType> input-type: InputType.text;
    callback edited(string);
    // OK or Enter.
    callback accepted(string);
    height: 52px;
    background: #2a2e33;
    // Bumped to pull focus back into the field while the bar stays open.
    in property <int> focus-rev;
    changed focus-rev => { edit.focus(); }
    Rectangle { height: 1px; y: 0px; background: #4fc3f7; }
    HorizontalLayout {
        padding: 4px;
        spacing: 6px;
        Text {
            text: root.label;
            color: #c3cad2;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
            max-width: 110px;
        }
        edit := LineEdit {
            height: 44px;
            horizontal-stretch: 1;
            text <=> root.text;
            input-type: root.input-type;
            edited(t) => { root.edited(t); }
            accepted(t) => { root.accepted(t); }
            init => { self.focus(); }
        }
        ToolButton {
            text: "OK";
            min-width: 56px;
            height: 44px;
            clicked => { root.accepted(root.text); }
        }
    }
}

// A selectable chip, at least 44px tall.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 44px;
    min-width: 44px;
    border-radius: 4px;
    background: root.selected ? #3a6ea5 : ta.pressed ? #4a5058 : #383d44;
    Text {
        text: root.text;
        color: white;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Dimmed full-window backdrop with a centred card; swallows all taps.
export component ModalCard inherits Rectangle {
    in property <length> card-width: 360px;
    // The card is lifted so that it ends above the on-screen keyboard (bottom-limit)
    // and stays below the top inset (top-limit).
    in property <length> top-limit: 0px;
    in property <length> bottom-limit: 100000px;
    background: #000000a0;
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(root.top-limit, min(min(parent.height * 0.12, 80px), root.bottom-limit - self.height - 8px));
        width: min(parent.width - 24px, root.card-width);
        height: inner.preferred-height + 24px;
        background: #2a2e33;
        border-radius: 8px;
        inner := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            @children
        }
    }
}

// Step 1: name the new component. Step 2: add properties / callbacks to it.
export component ExtractDialog inherits ModalCard {
    in property <int> step;
    in property <string> error;
    callback name-changed(int, string);
    callback run(string);
    callback add(int /* kind */, string /* type */, string /* name */);
    callback close();
    property <int> kind;
    property <string> ty: "string";

    if root.step == 1: VerticalLayout {
        spacing: 8px;
        Text { text: "部品にする"; color: white; font-size: 16px; }
        Text { text: "新しい部品の名前"; color: #9aa3ad; font-size: 12px; }
        name1 := LineEdit {
            height: 44px;
            placeholder-text: "例: Card";
            edited(t) => { root.name-changed(1, t); }
            accepted(t) => { if t != "" && root.error == "" { root.run(t); } }
            init => { self.focus(); }
        }
        Text {
            text: root.error;
            color: #ff8a80;
            font-size: 12px;
            wrap: word-wrap;
            visible: root.error != "";
        }
        HorizontalLayout {
            spacing: 8px;
            height: 44px;
            ToolButton { text: "Cancel"; clicked => { root.close(); } }
            ToolButton {
                text: "OK";
                enabled: name1.text != "" && root.error == "";
                clicked => { root.run(name1.text); }
            }
        }
    }
    if root.step == 2: VerticalLayout {
        spacing: 8px;
        Text { text: "プロパティ/コールバックを追加"; color: white; font-size: 16px; }
        for row[r] in [["in property", "in-out property"], ["out property", "callback"]]: HorizontalLayout {
            spacing: 4px;
            for k[c] in row: Chip {
                text: k;
                horizontal-stretch: 1;
                selected: root.kind == r * 2 + c;
                clicked => { root.kind = r * 2 + c; }
            }
        }
        if root.kind != 3: VerticalLayout {
            spacing: 4px;
            for row[r] in [["string", "int", "float", "bool"], ["length", "color", "brush", "image"]]: HorizontalLayout {
                spacing: 4px;
                for t in row: Chip {
                    text: t;
                    horizontal-stretch: 1;
                    selected: root.ty == t;
                    clicked => { root.ty = t; }
                }
            }
        }
        name2 := LineEdit {
            height: 44px;
            placeholder-text: root.kind == 3 ? "例: clicked" : "例: label";
            edited(t) => { root.name-changed(2, t); }
        }
        Text {
            text: root.error;
            color: #ff8a80;
            font-size: 12px;
            wrap: word-wrap;
            visible: root.error != "";
        }
        HorizontalLayout {
            spacing: 8px;
            height: 44px;
            ToolButton { text: "Done"; clicked => { root.close(); } }
            ToolButton {
                text: "Add";
                enabled: name2.text != "" && root.error == "";
                clicked => {
                    root.add(root.kind, root.ty, name2.text);
                    name2.text = "";
                }
            }
        }
    }
}

export component RecoveryDialog inherits ModalCard {
    callback answered(bool);
    VerticalLayout {
        spacing: 12px;
        Text {
            text: "保存されていない変更があります。復元しますか?";
            color: white;
            font-size: 15px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            height: 44px;
            ToolButton { text: "いいえ"; clicked => { root.answered(false); } }
            ToolButton { text: "はい"; clicked => { root.answered(true); } }
        }
    }
}

// One dialog for the file operations: 1 new file, 2 rename file, 3 rename project, 4 save as.
export component FileOpDialog inherits ModalCard {
    in property <int> mode;
    in property <string> error;
    in property <[string]> projects;
    in property <string> initial;
    in property <string> initial-project;
    // The keyboard is up: the project list shrinks so the card still fits above it.
    in property <bool> compact;
    callback edited();
    callback run(string /* name */, string /* project */);
    callback close();
    property <string> target: root.initial-project;

    VerticalLayout {
        spacing: 8px;
        Text {
            text: root.mode == 1 ? "New file" : root.mode == 2 ? "Rename file"
                : root.mode == 3 ? "Rename project" : "Save as";
            color: white;
            font-size: 16px;
        }
        if root.mode == 1 || root.mode == 4: Text {
            text: "Project: " + root.target;
            color: #9aa3ad;
            font-size: 12px;
        }
        name := LineEdit {
            height: 44px;
            text: root.initial;
            placeholder-text: root.mode == 3 ? "project name" : "file name";
            edited(_) => { root.edited(); }
            accepted(t) => { if t != "" { root.run(t, root.target); } }
            init => { self.focus(); }
        }
        if root.mode == 4: ListView {
            height: root.compact ? 44px : 132px;
            for p in root.projects: Rectangle {
                height: 44px;
                background: p == root.target ? #3a4a5c : transparent;
                Text {
                    x: 8px;
                    text: p;
                    color: white;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.target = p; root.edited(); } }
            }
        }
        Text {
            text: root.error;
            color: #ff8a80;
            font-size: 12px;
            wrap: word-wrap;
            visible: root.error != "";
        }
        HorizontalLayout {
            spacing: 8px;
            height: 44px;
            ToolButton { text: "Cancel"; clicked => { root.close(); } }
            ToolButton {
                text: root.mode == 1 ? "Create" : root.mode == 4 ? "Save" : "OK";
                enabled: name.text != "";
                clicked => { root.run(name.text, root.target); }
            }
        }
    }
}
