import { Palette } from "std-widgets.slint";
import { Canvas, GuideBand, TidyMark } from "canvas.slint";
import { BottomPanel, KbBar, ToolButton, MenuList, NewProject, TreeRowItem, PropItem, PreviewItem, ExtractDialog, ParamDialog, InferDialog, InferItem, RecoveryDialog, FileActions, FileOpDialog, SettingsSection, GitHubActions } from "panels.slint";
import { GitHubDialog } from "github.slint";
export { TreeRowItem, PropItem, PreviewItem, GuideBand, TidyMark, InferItem }

export component Editor inherits Window {
    title: "Petaricon Editor";
    preferred-width: 480px;
    preferred-height: 800px;
    background: #1b1d20;

    in property <component-factory> factory;
    in property <string> error-text;
    in property <bool> has-selection;
    in property <bool> sel-movable: true;
    // The selection uses a user-defined component (「中を開く」), and 「戻る」 has a place to go.
    in property <bool> can-open-inside;
    in property <bool> can-go-back;
    // Selection rectangle in design coordinates.
    in property <length> sel-x;
    in property <length> sel-y;
    in property <length> sel-w;
    in property <length> sel-h;
    in property <[string]> projects;
    in property <[string]> files;
    in property <[string]> components;
    in property <string> current-project;
    in property <string> current-file;
    in property <string> current-component;
    in property <string> message;
    in property <bool> dirty;
    // Debug: PETARICON_FAKE_KEYBOARD=<height> pretends a keyboard of that height is up.
    in property <length> fake-keyboard;
    // Touch input (Android): Props values and guide numbers open the input bar directly, so the bar's
    // field is the only text input to take focus (Android hides/re-shows the keyboard on every
    // text-to-text focus change).
    in property <bool> touch-input: false;
    in property <[TreeRowItem]> tree-rows;
    in property <[string]> palette;
    in property <float> zoom-level: 1.0;
    in property <[PropItem]> props;
    in property <[PreviewItem]> preview-props;
    // Canvas screen size in px (per component, from .preview).
    in property <int> screen-w: 360;
    in property <int> screen-h: 640;
    in property <string> source-title;
    in-out property <string> source-text;
    in-out property <int> panel-tab: 0;
    // The canvas pan, read by the glue to place new parts in the visible area.
    in-out property <length> canvas-pan-x: 8px;
    in-out property <length> canvas-pan-y: 8px;
    // The visible canvas area, read by the glue to fit the zoom to the screen size.
    out property <length> canvas-view-w: cv.width;
    out property <length> canvas-view-h: cv.height;
    changed canvas-view-w => { root.view-changed(); }
    changed canvas-view-h => { root.view-changed(); }
    in property <bool> has-guides;
    in property <length> g-x;
    in property <length> g-y;
    in property <length> g-w;
    in property <length> g-h;
    in property <bool> g-vertical;
    in property <[GuideBand]> bands;
    in property <bool> has-align;
    in property <length> a-x;
    in property <length> a-y;
    in property <length> a-w;
    in property <length> a-h;
    in property <string> toast-text;
    in property <[TidyMark]> tidy-marks;
    // Anchor of the selection per axis: -1 not applicable (root, layout child), 0..3 left /
    // right / both / centre (top / bottom / both / centre), 4 an expression.
    in property <int> anchor-h: -1;
    in property <int> anchor-v: -1;
    callback anchor-chosen(int, int);
    // After a free Tidy: 付き方を推定 is offered; the dialog lists what it would write.
    in property <bool> can-infer;
    in-out property <bool> infer-open;
    in property <[InferItem]> infer-rows;
    callback infer-ask();
    callback infer-run();
    // Tolerance of Tidy in px (4..48, set in the menu).
    in property <int> tidy-tolerance: 16;
    in property <int> guides-rev;
    in-out property <int> extract-step;
    // 引数にする dialog.
    in-out property <bool> param-open;
    in property <string> param-name;
    in property <string> param-subject;
    in property <bool> param-need-type;
    in-out property <string> dialog-error;
    in-out property <bool> recovery-open;
    // File operation dialog: 0 closed, 1 new file, 2 rename file, 3 rename project, 4 save as.
    in-out property <int> file-op;
    // The project whose files the File menu lists (the glue moves it after renames).
    in-out property <string> menu-project: root.current-project;

    // GitHub dialog: 0 closed, 1 the open project's sync, 2 a new project from GitHub.
    in-out property <int> gh-mode;
    in property <string> gh-token-hint;
    in property <bool> gh-linked;
    in property <string> gh-link-text;
    in property <string> gh-status-text;
    in property <[string]> gh-conflicts;
    in property <bool> gh-busy;
    // Status chip in the message band while a transfer runs, or conflicts wait ("" none).
    in property <string> gh-chip;
    in property <string> gh-result;
    in property <string> gh-error;
    in-out property <string> gh-repo;
    in-out property <string> gh-branch;
    in-out property <string> gh-folder;
    in-out property <string> gh-name;
    in-out property <string> gh-message: "petaricon で編集";
    // The GitHub field the input bar edits ("" none, "token", "repo", "branch", "folder", "name", "message").
    in-out property <string> gh-editing;

    callback tapped(length, length);
    callback drag-finished(length, length);
    callback resize-finished(int /* Corner */, length, length);
    callback open-inside();
    callback go-back();
    callback undo();
    callback redo();
    callback save();
    callback open(string /* project */, string /* file */);
    callback select-project(string);
    callback create-project(string);
    callback choose-component(string);
    callback zoom(float /* multiplier */);
    // The visible canvas area changed size (window resize, panel drag, first layout).
    callback view-changed();
    callback tree-selected(int /* row */);
    callback tree-action(int /* TreeAction */);
    callback palette-picked(string);
    // A preview value of a bool property: name (a leading `!` means 偽), set or clear.
    callback preview-set(string, string);
    callback screen-size-chosen(int, int);
    callback prop-edited(string, string);
    callback param-ask(string);
    callback param-name-changed(string);
    callback param-run(string, string);
    callback prop-accepted(string, string);
    // The input bar closed because the keyboard went away: apply what was typed.
    callback prop-flush();
    callback source-apply(string);
    callback source-edited();
    callback error-tapped();
    callback tidy();
    callback tolerance-step(int /* -1 or +1 */);
    // The bottom panel tab changed: the Tidy overlay goes away.
    callback overlay-clear();
    callback stack();
    callback unstack();
    callback guide-edited(string, string);
    callback extract-open();
    callback name-changed(int /* step */, string);
    callback extract-run(string);
    callback declaration-add(int /* kind */, string /* type */, string /* name */);
    callback recovery-answered(bool);
    callback file-op-run(int /* mode */, string /* name */, string /* project */);
    callback gh-open();
    callback gh-open-new();
    callback gh-token-set(string);
    callback gh-token-clear();
    callback gh-pull();
    callback gh-push(string /* message */);
    callback gh-import(string /* repo */, string /* branch */, string /* folder */, string /* name */);
    callback gh-take-remote(string);
    callback gh-keep-local(string);
    callback gh-closed();

    init => { Palette.color-scheme = ColorScheme.dark; }

    // On-screen keyboard (window coordinates); both are 0 on desktop.
    property <length> kb-h: root.fake-keyboard > 0px ? root.fake-keyboard : root.virtual-keyboard-size.height;
    property <length> kb-y: root.fake-keyboard > 0px ? root.height - root.fake-keyboard : root.virtual-keyboard-position.y;
    out property <bool> kb-shown: root.kb-h > 0px;
    // Input bar above the keyboard, for a Props value or a guide number that the keyboard covers.
    property <length> bar-h: 52px;
    property <int> bar-focus-rev;
    property <string> prop-editing;
    property <length> prop-bottom;
    in-out property <string> bar-text;
    out property <bool> want-prop: root.prop-editing != "" && (root.touch-input
        || (root.kb-shown && root.prop-bottom > root.kb-y));
    out property <bool> want-guide: cv.editing-prop != "" && (root.touch-input
        || (root.kb-shown && root.content-y + cv.editing-y + 44px > root.kb-y));
    property <string> gh-label: root.gh-editing == "token" ? "トークン" : root.gh-editing == "repo" ? "リポジトリ"
        : root.gh-editing == "branch" ? "ブランチ" : root.gh-editing == "folder" ? "フォルダ"
        : root.gh-editing == "name" ? "プロジェクト名" : "メッセージ";
    out property <bool> want-gh: root.gh-editing != "";
    out property <bool> bar-visible: root.want-prop || root.want-guide || root.want-gh;
    // Bumped by the glue whenever the Props rows are rebuilt (selection, document or undo changed).
    in property <int> props-rev;
    // props-rev when the field got focus: bar edits for an older target are rejected.
    property <int> prop-rev-at;
    property <bool> guide-bar-used;
    // Ends a Props bar session: the pending edit is applied to its original target first.
    function close-prop-bar() {
        if root.prop-editing != "" {
            root.prop-editing = "";
            root.prop-flush();
        }
    }
    // GitHub fields: every keystroke lands in the dialog's property; the token is handed to the
    // glue only when it is accepted (or when the bar closes with a token typed).
    function gh-apply(field: string, t: string) {
        if field == "repo" { root.gh-repo = t; }
        else if field == "branch" { root.gh-branch = t; }
        else if field == "folder" { root.gh-folder = t; }
        else if field == "name" { root.gh-name = t; }
        else if field == "message" { root.gh-message = t; }
    }
    function gh-current(field: string) -> string {
        if field == "repo" { return root.gh-repo; }
        if field == "branch" { return root.gh-branch; }
        if field == "folder" { return root.gh-folder; }
        if field == "name" { return root.gh-name; }
        if field == "message" { return root.gh-message; }
        return "";
    }
    public function gh-open-bar(field: string) {
        root.close-prop-bar();
        root.gh-editing = field;
        root.bar-text = root.gh-current(field);
        root.bar-focus-rev += 1;
    }
    function gh-finish(t: string) {
        if root.gh-editing == "token" {
            if t != "" { root.gh-token-set(t); }
        } else {
            root.gh-apply(root.gh-editing, t);
        }
        root.gh-editing = "";
        root.bar-text = "";
    }
    function close-gh-bar() {
        if root.gh-editing != "" { root.gh-finish(root.bar-text); }
    }
    // Ends a guide bar session after the keyboard went away: the typed number is kept.
    function finish-guide-bar() {
        if root.guide-bar-used {
            root.guide-bar-used = false;
            if cv.editing-prop != "" && root.bar-text != cv.editing-value {
                root.guide-edited(cv.editing-prop, root.bar-text);
            }
            cv.editing-prop = "";
        }
    }
    // Touch input: the bar sits above the keyboard, or at the window bottom until it shows up.
    property <length> bar-y: root.kb-shown ? root.kb-y - root.bar-h : root.height - root.inset-bottom - root.bar-h;
    // The keyboard has been up during this bar session (so a later hide is a real hide).
    property <bool> kb-seen;
    // True for 500 ms after the bar opened: keyboard hides then are never acted on.
    property <bool> open-guard;
    Timer {
        interval: 500ms;
        running: root.open-guard;
        triggered => { root.open-guard = false; }
    }
    // Touch input: closes the bar once the keyboard has stayed hidden for 300 ms.
    Timer {
        interval: 300ms;
        running: root.touch-input && root.bar-visible && root.kb-seen && !root.kb-shown;
        triggered => {
            if !root.open-guard {
                root.close-prop-bar();
                root.finish-guide-bar();
                root.close-gh-bar();
            }
        }
    }
    changed bar-visible => {
        root.kb-seen = root.bar-visible && root.kb-shown;
        root.open-guard = root.bar-visible;
    }
    changed kb-shown => {
        if root.kb-shown {
            root.kb-seen = root.bar-visible;
        } else if !root.touch-input {
            root.close-prop-bar();
            root.finish-guide-bar();
            root.close-gh-bar();
        }
    }
    changed props-rev => { root.prop-editing = ""; }
    changed panel-tab => { root.close-prop-bar(); root.overlay-clear(); }
    changed want-guide => {
        if root.want-guide {
            root.close-prop-bar();
            root.guide-bar-used = true;
            root.bar-text = cv.editing-value;
        } else if !root.kb-shown && !root.touch-input {
            root.finish-guide-bar();
        } else if cv.editing-prop == "" {
            root.guide-bar-used = false;
        }
    }
    property <length> panel-bottom: root.content-y + root.content-h;

    property <bool> menu-open;
    property <bool> wide: root.width > root.height;
    property <length> inset-top: root.safe-area-insets.top;
    property <length> inset-bottom: root.safe-area-insets.bottom;
    property <length> inset-left: root.safe-area-insets.left;
    property <length> inset-right: root.safe-area-insets.right;
    property <length> content-w: root.width - root.inset-left - root.inset-right;
    property <length> row-h: 44px;
    // Below this width the toolbar needs two rows.
    property <bool> narrow: root.content-w < 600px;
    property <length> toolbar-h: root.narrow ? 2 * (root.row-h + 8px) : root.row-h + 8px;
    property <length> band-h: root.error-text != "" ? 44px : (root.message != "" || root.gh-chip != "") ? 30px : 0px;
    property <length> content-y: root.inset-top + root.toolbar-h + root.band-h;
    property <length> content-h: root.height - root.content-y - root.inset-bottom;
    in-out property <length> panel-h: 0px;
    property <length> panel-h-eff: root.panel-h > 0px
        ? min(root.panel-h, root.content-h * 0.7) : root.content-h * 0.4;
    property <length> panel-w: min(root.content-w * 0.4, 360px);

    Rectangle {
        x: root.inset-left;
        y: root.inset-top;
        width: root.content-w;
        height: root.toolbar-h;
        background: #2a2e33;

        // Row 1 (narrow) or the whole bar (wide).
        row1 := Flickable {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.row-h + 8px;
            content-width: max(self.width, row1-layout.min-width + 8px);
            content-height: self.height;
            row1-layout := HorizontalLayout {
                x: 0px;
                width: row1.content-width;
                padding: 4px;
                spacing: 3px;
                // Drawn icon: three bars (no font glyph).
                Rectangle {
                    min-width: 48px;
                    preferred-width: 48px;
                    horizontal-stretch: 0;
                    border-radius: 4px;
                    background: menu-ta.pressed ? #4a5058 : #383d44;
                    for k in 3: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - 9px + k * 8px - 1px;
                        width: 20px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: white;
                    }
                    menu-ta := TouchArea { clicked => { root.menu-open = true; } }
                }
                ToolButton { text: "Undo"; clicked => { root.undo(); } }
                ToolButton { text: "Redo"; clicked => { root.redo(); } }
                ToolButton { text: root.dirty ? "Save*" : "Save"; min-width: 64px; clicked => { root.save(); } }
                if !root.narrow: ToolButton { text: "Tidy"; min-width: 56px; clicked => { root.tidy(); } }
                if !root.narrow: ToolButton { text: "Stack"; min-width: 60px; clicked => { root.stack(); } }
                if !root.narrow: ToolButton { text: "Unstack"; min-width: 72px; clicked => { root.unstack(); } }
                if !root.narrow: ToolButton { text: "Extract"; min-width: 68px; clicked => { root.extract-open(); } }
                ToolButton { text: "戻る"; enabled: root.can-go-back; min-width: 56px; clicked => { root.go-back(); } }
                ToolButton { text: "中を開く"; enabled: root.can-open-inside; min-width: 84px; clicked => { root.open-inside(); } }
                ToolButton { text: "-"; clicked => { root.zoom(0.8); } }
                ToolButton { text: "+"; clicked => { root.zoom(1.25); } }
            }
        }
        // Row 2 (narrow only).
        if root.narrow: row2 := Flickable {
            x: 0px;
            y: root.row-h + 8px;
            width: parent.width;
            height: root.row-h + 8px;
            content-width: max(self.width, row2-layout.min-width + 8px);
            content-height: self.height;
            row2-layout := HorizontalLayout {
                x: 0px;
                width: row2.content-width;
                padding: 4px;
                spacing: 3px;
                ToolButton { text: "Tidy"; min-width: 56px; clicked => { root.tidy(); } }
                ToolButton { text: "Stack"; min-width: 60px; clicked => { root.stack(); } }
                ToolButton { text: "Unstack"; min-width: 72px; clicked => { root.unstack(); } }
                ToolButton { text: "Extract"; min-width: 68px; clicked => { root.extract-open(); } }
            }
        }
    }

    Rectangle {
        x: root.inset-left;
        y: root.inset-top + root.toolbar-h;
        width: root.content-w;
        height: root.band-h;
        background: root.error-text != "" ? #b3261e : #2e5d34;
        clip: true;
        Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.error-text != "" ? root.error-text : root.message;
            color: white;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            enabled: root.error-text != "";
            clicked => { root.error-tapped(); }
        }
        if root.gh-chip != "": Rectangle {
            x: parent.width - self.width - 4px;
            y: 2px;
            width: min(190px, parent.width / 2);
            height: parent.height - 4px;
            border-radius: 4px;
            background: #1565c0;
            Text {
                text: root.gh-chip;
                color: white;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea { clicked => { root.gh-open(); } }
        }
    }

    cv := Canvas {
        x: root.inset-left;
        y: root.content-y;
        width: root.wide ? root.content-w - root.panel-w : root.content-w;
        height: root.wide ? root.content-h : root.content-h - root.panel-h-eff;
        factory: root.factory;
        design-w: root.screen-w * 1px;
        design-h: root.screen-h * 1px;
        popup-hidden: root.want-guide;
        touch-input: root.touch-input;
        has-selection: root.has-selection;
        sel-movable: root.sel-movable;
        sel-x: root.sel-x;
        sel-y: root.sel-y;
        sel-w: root.sel-w;
        sel-h: root.sel-h;
        zoom: root.zoom-level;
        pan-x <=> root.canvas-pan-x;
        pan-y <=> root.canvas-pan-y;
        has-guides: root.has-guides;
        guides-rev: root.guides-rev;
        g-x: root.g-x;
        g-y: root.g-y;
        g-w: root.g-w;
        g-h: root.g-h;
        g-vertical: root.g-vertical;
        bands: root.bands;
        has-align: root.has-align;
        tidy-marks: root.tidy-marks;
        pin-h: root.anchor-h;
        pin-v: root.anchor-v;
        a-x: root.a-x;
        a-y: root.a-y;
        a-w: root.a-w;
        a-h: root.a-h;
        guide-edited(p, v) => { root.guide-edited(p, v); }
        tapped(x, y) => { root.tapped(x, y); }
        drag-finished(dx, dy) => { root.drag-finished(dx, dy); }
        resize-finished(c, dx, dy) => { root.resize-finished(c, dx, dy); }
        zoom-by(m) => { root.zoom(m); }
    }

    BottomPanel {
        x: root.wide ? root.inset-left + root.content-w - root.panel-w : root.inset-left;
        y: root.wide ? root.content-y : root.content-y + root.content-h - root.panel-h-eff;
        width: root.wide ? root.panel-w : root.content-w;
        height: root.wide ? root.content-h : root.panel-h-eff;
        handle-visible: !root.wide;
        max-h: root.content-h * 0.7;
        panel-h <=> root.panel-h;
        tree-rows: root.tree-rows;
        palette: root.palette;
        props: root.props;
        anchor-h: root.anchor-h;
        anchor-v: root.anchor-v;
        anchor-chosen(a, k) => { root.anchor-chosen(a, k); }
        preview-props: root.preview-props;
        screen-w: root.screen-w;
        screen-h: root.screen-h;
        preview-set(n, v) => { root.preview-set(n, v); }
        screen-size-chosen(w, h) => { root.screen-size-chosen(w, h); }
        source-title: root.source-title;
        source-text <=> root.source-text;
        touch-input: root.touch-input;
        kb-overlap: root.kb-shown ? max(0px, root.panel-bottom - root.kb-y) : 0px;
        tab <=> root.panel-tab;
        value-focused(n, t, b) => {
            // Switching fields while the bar is open: the old target gets its pending edit first.
            if root.prop-editing != "" && root.prop-editing != n { root.close-prop-bar(); }
            root.prop-editing = n;
            root.prop-bottom = b;
            root.prop-rev-at = root.props-rev;
            root.bar-text = t;
            root.bar-focus-rev += 1;
        }
        value-blurred => { if !root.bar-visible { root.prop-editing = ""; } }
        prop-edited(n, v) => { root.prop-edited(n, v); }
        prop-accepted(n, v) => { root.prop-accepted(n, v); }
        param-open(n) => { root.param-ask(n); }
        source-apply(t) => { root.source-apply(t); }
        source-edited() => { root.source-edited(); }
        tree-selected(i) => { root.tree-selected(i); }
        tree-action(a) => { root.tree-action(a); }
        palette-picked(n) => { root.palette-picked(n); }
    }

    if root.can-infer: Rectangle {
        x: cv.x + 8px;
        y: cv.y + cv.height - self.height - 8px;
        width: 132px;
        height: 44px;
        border-radius: 22px;
        background: infer-ta.pressed ? #2f8f6f : #00a878;
        Text {
            text: "付き方を推定";
            color: white;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        infer-ta := TouchArea { clicked => { root.infer-ask(); } }
    }

    if root.kb-shown && root.fake-keyboard > 0px: Rectangle {
        x: 0px;
        y: root.kb-y;
        width: root.width;
        height: root.kb-h;
        background: #555a60;
        Text { text: "fake keyboard"; color: white; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    }

    if root.gh-mode != 0: GitHubDialog {
        mode: root.gh-mode;
        project: root.current-project;
        token-hint: root.gh-token-hint;
        linked: root.gh-linked;
        link-text: root.gh-link-text;
        status-text: root.gh-status-text;
        conflicts: root.gh-conflicts;
        busy: root.gh-busy;
        result: root.gh-result;
        error: root.gh-error;
        editing: root.gh-editing;
        top-limit: root.inset-top;
        bottom-limit: root.want-gh ? root.bar-y : root.kb-shown ? root.kb-y : root.height - root.inset-bottom;
        repo <=> root.gh-repo;
        branch <=> root.gh-branch;
        folder <=> root.gh-folder;
        name <=> root.gh-name;
        message <=> root.gh-message;
        edit(f) => { root.gh-open-bar(f); }
        token-clear => { root.gh-token-clear(); }
        pull => { root.gh-pull(); }
        push(m) => { root.gh-push(m); }
        submit-new(r, b, f, n) => { root.gh-import(r, b, f, n); }
        take-remote(p) => { root.gh-take-remote(p); }
        keep-local(p) => { root.gh-keep-local(p); }
        close => { root.close-gh-bar(); root.gh-mode = 0; root.gh-closed(); }
    }

    if root.bar-visible: Rectangle {
        x: 0px;
        y: root.touch-input || root.want-gh ? root.bar-y : root.kb-y - root.bar-h;
        width: root.width;
        height: root.bar-h;
        background: #2a2e33;
        KbBar {
            focus-rev: root.bar-focus-rev;
            x: root.inset-left;
            width: root.content-w;
            label: root.want-gh ? root.gh-label : root.want-guide ? cv.editing-prop : root.prop-editing;
            text <=> root.bar-text;
            input-type: root.want-gh ? (root.gh-editing == "token" ? InputType.password : InputType.text)
                : root.want-guide ? InputType.number : InputType.text;
            edited(t) => {
                if root.want-gh {
                    if root.gh-editing != "token" { root.gh-apply(root.gh-editing, t); }
                } else if !root.want-guide && root.prop-rev-at == root.props-rev {
                    root.prop-edited(root.prop-editing, t);
                }
            }
            accepted(t) => {
                if root.want-gh {
                    root.gh-finish(t);
                } else if root.want-guide {
                    root.guide-bar-used = false;
                    root.guide-edited(cv.editing-prop, t);
                    cv.editing-prop = "";
                } else {
                    if root.prop-rev-at == root.props-rev {
                        root.prop-accepted(root.prop-editing, t);
                    }
                    root.prop-editing = "";
                }
            }
        }
    }

    if root.toast-text != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - root.inset-bottom - self.height - 24px;
        width: min(root.width - 32px, 420px);
        height: toast-label.preferred-height + 24px;
        background: #000000d0;
        border-radius: 8px;
        toast-label := Text {
            x: 8px;
            y: 12px;
            width: parent.width - 16px;
            text: root.toast-text;
            color: white;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.menu-open: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { root.menu-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.inset-top + 8px;
            width: min(parent.width - 24px, 420px);
            height: min(parent.height - root.inset-top - root.inset-bottom - 16px, 640px);
            background: #2a2e33;
            border-radius: 8px;
            // Swallow taps that land on the menu itself.
            TouchArea { }

            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                MenuList {
                    title: "Projects";
                    items: root.projects;
                    current: root.menu-project;
                    picked(p) => { root.menu-project = p; root.select-project(p); }
                }
                NewProject {
                    create(n) => { root.create-project(n); root.menu-project = n; root.select-project(n); }
                    rename => { root.menu-open = false; root.dialog-error = ""; root.file-op = 3; }
                }
                GitHubActions {
                    sync => { root.menu-open = false; root.gh-open(); }
                    new-project => { root.menu-open = false; root.gh-open-new(); }
                }
                MenuList {
                    title: "Files";
                    items: root.files;
                    current: root.menu-project == root.current-project ? root.current-file : "";
                    picked(f) => { root.menu-open = false; root.open(root.menu-project, f); }
                }
                FileActions {
                    new-file => { root.menu-open = false; root.dialog-error = ""; root.file-op = 1; }
                    rename => { root.menu-open = false; root.dialog-error = ""; root.file-op = 2; }
                    save-as => { root.menu-open = false; root.dialog-error = ""; root.file-op = 4; }
                }
                MenuList {
                    title: "Components";
                    items: root.components;
                    current: root.current-component;
                    picked(c) => { root.menu-open = false; root.choose-component(c); }
                }
                SettingsSection {
                    tolerance: root.tidy-tolerance;
                    step(d) => { root.tolerance-step(d); }
                }
                ToolButton { text: "Close"; height: 44px; clicked => { root.menu-open = false; } }
            }
        }
    }

    if root.infer-open: InferDialog {
        rows: root.infer-rows;
        top-limit: root.inset-top;
        accepted => { root.infer-run(); }
        close => { root.infer-open = false; }
    }

    if root.extract-step != 0: ExtractDialog {
        step: root.extract-step;
        error: root.dialog-error;
        top-limit: root.inset-top;
        bottom-limit: root.kb-shown ? root.kb-y : root.height;
        name-changed(st, t) => { root.name-changed(st, t); }
        run(n) => { root.extract-run(n); }
        add(k, t, n) => { root.declaration-add(k, t, n); }
        close => { root.extract-step = 0; root.dialog-error = ""; }
    }

    if root.param-open: ParamDialog {
        error: root.dialog-error;
        initial-name: root.param-name;
        subject: root.param-subject;
        need-type: root.param-need-type;
        top-limit: root.inset-top;
        bottom-limit: root.kb-shown ? root.kb-y : root.height;
        name-changed(t) => { root.param-name-changed(t); }
        run(n, t) => { root.param-run(n, t); }
        close => { root.param-open = false; root.dialog-error = ""; }
    }

    if root.file-op != 0: FileOpDialog {
        mode: root.file-op;
        error: root.dialog-error;
        projects: root.projects;
        top-limit: root.inset-top;
        bottom-limit: root.kb-shown ? root.kb-y : root.height;
        compact: root.kb-shown;
        initial: root.file-op == 2 || root.file-op == 4 ? root.current-file
            : root.file-op == 3 ? root.menu-project : "";
        initial-project: root.file-op == 4 ? root.current-project : root.menu-project;
        edited => { root.dialog-error = ""; }
        run(n, p) => { root.file-op-run(root.file-op, n, p); }
        close => { root.file-op = 0; root.dialog-error = ""; }
    }

    if root.recovery-open: RecoveryDialog {
        answered(r) => { root.recovery-answered(r); }
    }
}
